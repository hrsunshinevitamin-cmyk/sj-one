function showSJOneOperatorMode(){const ss=SpreadsheetApp.getActiveSpreadsheet();const visible=['오늘_영업판단','기업_원스탑','투자_체크'];const fallback=ss.getSheets()[0].getName();ss.getSheets().forEach(s=>{const n=s.getName();if(visible.indexOf(n)>=0||n===fallback)s.showSheet();else s.hideSheet();});const first=ss.getSheetByName('오늘_영업판단')||ss.getSheets()[0];ss.setActiveSheet(first);ss.toast('운영모드 완료','SJ ONE',6);}function showSJOneAdminMode(){const ss=SpreadsheetApp.getActiveSpreadsheet();ss.getSheets().forEach(s=>s.showSheet());ss.toast('관리자모드 완료','SJ ONE',6);}function doGet(e){const payload={ok:true,updatedAt:new Date(),daily:sheetToObjectsSJONE_('오늘_영업판단',50),onestop:sheetToObjectsSJONE_('기업_원스탑',30),alt:sheetToObjectsSJONE_('대안타깃_DB',50),candidates:sheetToObjectsSJONE_('후보자_DB',50),investments:sheetToObjectsSJONE_('투자_체크',30)};return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON);}function sheetToObjectsSJONE_(name,limit){const ss=SpreadsheetApp.getActiveSpreadsheet();const sh=ss.getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];const values=sh.getDataRange().getDisplayValues();const headers=values[0];return values.slice(1,limit?limit+1:undefined).map(row=>{const obj={};headers.forEach((h,i)=>obj[h]=row[i]);return obj;});}