function doGet(e){const payload={ok:true,updatedAt:new Date(),daily:sheetToObjectsSJONE_('오늘_영업판단',50),onestop:sheetToObjectsSJONE_('기업_원스탑',30),alt:sheetToObjectsSJONE_('대안타깃_DB',50)};return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON);}function sheetToObjectsSJONE_(name,limit){const ss=SpreadsheetApp.getActiveSpreadsheet();const sh=ss.getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];const values=sh.getDataRange().getDisplayValues();const headers=values[0];return values.slice(1,limit?limit+1:undefined).map(row=>{const obj={};headers.forEach((h,i)=>obj[h]=row[i]);return obj;});}